# ===========================================================================
# Auri — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_USER=auri
DB_PASSWORD=change_me_in_production
DB_NAME=auri
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=generate_a_random_secret_key_here
ENCRYPTION_KEY=generate_a_32_byte_hex_key_for_pgcrypto

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here      # also set BOT_TOKEN above
BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
MODERATOR_TELEGRAM_CHAT_ID=your_moderator_telegram_chat_id_here  # flagged confessions relay here
MODERATION_API_KEY=generate_a_random_shared_secret_for_the_bot_to_use
MODERATION_POLL_SECONDS=30  # bot: how often to poll the backend moderation queue
DELIVERY_API_KEY=generate_a_random_shared_secret_for_the_bot_to_use  # bot calls /api/v1/delivery/*
DELIVERY_POLL_SECONDS=30  # bot: how often to poll the backend delivery queue
DEPARTMENT_CHAT_IDS=HR:111111,Engineering:222222,Management:333333  # bot: department -> Telegram chat id
BACKEND_URL=http://localhost:8000  # bot: base URL of the Auri backend API

# ---------------------------------------------------------------------------
# Admin dashboard (Phase 10, local dev) — shared secret for /api/v1/admin/*
# ---------------------------------------------------------------------------
ADMIN_API_KEY=generate_a_random_shared_secret_for_the_dashboard_to_use

# ---------------------------------------------------------------------------
# Staff accounts (Phase 11) — first-admin bootstrap. Applied at startup only
# while the users table is empty; every later account is created by an admin
# from the dashboard. Leave either value blank to skip bootstrap.
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@your-company.example
ADMIN_BOOTSTRAP_PASSWORD=generate_a_strong_password_min_12_chars

# Session tokens for dashboard logins. Falls back to SECRET_KEY when blank;
# signing refuses to run outside ENVIRONMENT=development while the secret is
# still the shipped placeholder.
SESSION_TOKEN_SECRET=generate_a_random_32_byte_secret_here
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5              # failed logins per email before lockout
LOGIN_ATTEMPT_WINDOW_SECONDS=300
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=generate_a_random_webhook_secret_here  # required when ENVIRONMENT=production
PORT=8080
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Recipient directory (comma-separated, admin-managed — no LDAP/HRIS)
# ---------------------------------------------------------------------------
DEPARTMENTS=HR,Engineering,Management

# ---------------------------------------------------------------------------
# Data retention — purge forwarded/deleted confessions this many hours after
# their last update. Run via cron/k8s CronJob: python -m app.services.retention
# ---------------------------------------------------------------------------
RETENTION_HOURS=24
# A replied confession is emptied after RETENTION_HOURS but its HR reply is kept,
# so the confessor can still read it, for this many days after the reply.
REPLY_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# LLM — PII de-identification / categorisation / summarisation provider.
# LLMService(provider="auto") tries these in order, first non-empty reply
# wins: Ollama (local, free) -> Gemini -> OpenAI.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Explicit-provider-only (LLMService(provider="claude")) — not in the auto chain.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------------
# LiveKit — self-hosted real-time voice SFU (Phase 7). Local dev only: the
# `livekit` docker-compose service (profile "optional") runs in --dev mode,
# which hardcodes these devkey/devsecret — no cloud account needed.
# Use the dev machine's LAN IP (not localhost) so a real phone on the same
# Wi-Fi can reach it; do not tunnel this through ngrok (WebRTC needs UDP).
# ---------------------------------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# Audio / STT / TTS
# ---------------------------------------------------------------------------
WHISPER_MODEL=base
EDGE_TTS_VOICE=en-US-JennyNeural

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional — empty disables Sentry entirely.
# python-dotenv does not strip inline comments when the value before them
# is empty, so SENTRY_DSN= followed by a trailing "# comment" on the same
# line ends up set to the literal comment text, not "" — keep this comment
# on its own line above, never inline after an empty value.
SENTRY_DSN=
# Bearer token a Prometheus scrape job must send to GET /metrics. Leave empty
# and /metrics answers 403 to everyone. Generate one with:
#   openssl rand -hex 32
# and give the same value to the scrape job (authorization.credentials).
METRICS_API_KEY=

# ---------------------------------------------------------------------------
# CORS / Rate Limiting
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173
CONFESSION_RATE_LIMIT_SECONDS=300

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
