# Auri Backend - Environment Variables
# Copy this file to .env and fill in real values.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auri
DB_USER=auri
DB_PASS=your_database_password_here

# Security
SECRET_KEY=change-me-to-a-long-random-string

# Staff single sign-on through any OpenID Connect provider (docs/adr/staff-sso.md).
# Off until the first five are set. Password login keeps working.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_DASHBOARD_URL=
OIDC_PROVIDER_LABEL=Single sign-on
OIDC_REQUIRE_EMAIL_VERIFIED=true
# Optional: let the provider decide the role, e.g. OIDC_ROLE_CLAIM=groups and
# OIDC_ROLE_MAP={"auri-admins": "admin", "auri-hr": "hr"}
OIDC_ROLE_CLAIM=
OIDC_ROLE_MAP=

# Speech-to-Text
WHISPER_MODEL=base
STT_RATE_LIMIT_SECONDS=10
STT_MAX_UPLOAD_BYTES=26214400
# Longest recording accepted, in seconds; keep equal to the app's MAX_RECORDING_DURATION_MS.
MAX_RECORDING_SECONDS=300

# LLM — auto chain: Ollama (local) -> Gemini -> OpenAI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Context window asked of Ollama; a cap keeps a small model small in memory.
OLLAMA_NUM_CTX=4096
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# LiveKit — self-hosted (Phase 7). `docker compose --profile optional up livekit`
# runs --dev mode, which hardcodes devkey/secret. Use LAN IP, not localhost,
# so a real device on the same Wi-Fi can connect; never tunnel through ngrok.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
MODERATOR_TELEGRAM_CHAT_ID=your-moderator-telegram-chat-id-here
MODERATION_API_KEY=generate-a-random-shared-secret-for-the-bot-to-use
DELIVERY_API_KEY=generate-a-random-shared-secret-for-the-bot-to-use

# Admin dashboard (Phase 10, local dev) — shared secret for /api/v1/admin/*
ADMIN_API_KEY=generate-a-random-shared-secret-for-the-dashboard-to-use

# Recipient directory (comma-separated, admin-managed)
DEPARTMENTS=HR,Engineering,Management

# Data retention — purge forwarded/deleted confessions this many hours after
# their last update. Run via cron/k8s CronJob: python -m app.services.retention
RETENTION_HOURS=24

# Store each phone's code as an HMAC with this secret (32+ characters:
# openssl rand -hex 32). Empty leaves codes as the phone sent them. Existing rows
# are upgraded as each phone returns, or all at once with
# `python -m app.services.device_identity`. Losing or changing this value strands
# every phone's history and unread HR replies.
DEVICE_HASH_PEPPER=

# Environment / Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Priest mode ("Guide") — answers from a study vault; OFF by default. The flag and
# tuning keys can also be set from the dashboard (Config tab); the address, key and
# paths below are environment only on purpose.
# ---------------------------------------------------------------------------
PRIEST_MODE_ENABLED=false
PRIEST_PERSONA_NAME=Guide
# OpenAI-compatible chat server (vLLM). Empty reuses the THEMES_LLM_* server for the
# prototype; it never falls back to a third-party API. Questions are sent here.
PRIEST_LLM_BASE_URL=
PRIEST_LLM_API_KEY=
# Exactly the name the server lists at /v1/models. Empty uses THEMES_LLM_MODEL (the
# prototype shortcut); required when PRIEST_LLM_BASE_URL is set.
PRIEST_LLM_MODEL=
PRIEST_LLM_ALLOW_INSECURE_HTTP=false
# Local Ollama used if the primary fails; empty derives it from OLLAMA_BASE_URL.
PRIEST_FALLBACK_BASE_URL=
PRIEST_FALLBACK_MODEL=
PRIEST_EMBED_MODEL=bge-large
PRIEST_VAULT_DIR=/app/data/priest/vault
PRIEST_INDEX_DIR=/app/data/priest/index

# Contacts in the fixed crisis reply. Never generated; empty uses a compiled-in message.
CRISIS_HELPLINE_NAME=
CRISIS_HELPLINE_NUMBER=
CRISIS_EAP_CONTACT=
